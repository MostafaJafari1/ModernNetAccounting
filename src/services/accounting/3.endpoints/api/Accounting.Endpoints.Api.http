###

// Create a New Account
POST {{Accounting.Endpoints.Api_HostAddress}}/api/v1/account
Content-Type: application/json

{
  "code": "1",
  "name": "حساب معین موجودی نقد و بانک",
  "parentId": null,
  "level": 1, 
  "nature": 1,
  "isPostable": true
}

